{
  "name": "@icon-by-solar/react",
  "version": "1.0.2",
  "type": "module",
  "description": "Official React icon library for Icon by Solar, supporting Outline, Bold, and Bold Duotone styles with full TypeScript definitions and tree-shaking.",
  "author": "Icon by Solar (Artwork by 480 Design)",
  "license": "(MIT AND CC-BY-4.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiyo1922/Icon-by-Solar.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tiyo1922/Icon-by-Solar#readme",
  "bugs": {
    "url": "https://github.com/tiyo1922/Icon-by-Solar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js",
      "require": "./dist/all.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "require": "./dist/icons/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "icons/*": [
        "dist/icons/*"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "all": [
        "dist/all.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "icon-by-solar",
    "solar-icons",
    "react-icons",
    "svg-icons",
    "duotone-icons",
    "react",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsup && python3 ../../tools/build_react_icons.py",
    "typecheck": "tsc --noEmit"
  }
}
